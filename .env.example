# Copy this file to .env locally, or set these as environment variables in
# your hosting provider's dashboard (e.g. Render > Environment). NEVER commit
# a real .env file or put these values inside the Android app.

# Supabase project settings (Project Settings > API in the Supabase dashboard)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here

# Optional override for the fetch source URL used by src/scraper.js.
# Leave empty to fetch ISIMS directly, or set this to a relay/proxy URL that
# returns the ISIMS homepage HTML when direct cloud access is blocked.
# Example: https://your-relay.example.com/isims/home
ISIMS_HOME_URL=

# Port the Express server listens on (Render sets this automatically; only
# needed for local dev)
PORT=3000
